# 复制为 .env 后按需修改。config.py 会用 os.getenv 读取这些值覆盖默认。
# 注意：请勿把真实 API Key 提交到 git。

# ---- VLM（场景图预测）----
# 阿里云百炼 / DashScope 或兼容 OpenAI 的 Qwen 接口 Key
DASHSCOPE_API_KEY=your_api_key_here
QWEN_API_KEY=your_api_key_here
# 若使用第三方兼容端点，填其 base_url，例如 https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_BASE_URL=

# ---- FLUX（图像生成）----
MODEL_PATH=/home/hdd4/lpz/FLUX.1-dev2
DEVICE=cuda:2

# ---- 服务 ----
HOST=0.0.0.0
PORT=8888
